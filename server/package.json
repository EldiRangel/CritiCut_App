{
  "name": "criticut-api",
  "version": "1.0.0",
  "private": true,
  "description": "API en la nube de CritiCut (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply criticut-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply criticut-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.166.0"
  }
}
