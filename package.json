{
  "name": "criticut",
  "version": "1.0.0",
  "private": true,
  "description": "CritiCut - Reseñas de películas y series con Ionic + Angular",
  "author": "Eldi Rangel",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:mobile": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "cap:sync": "ng build && cap sync",
    "cap:android": "cap open android",
    "apk": "npm run build && cap sync android && cd android && gradlew assembleDebug",
    "server:dev": "npm --prefix server run dev",
    "server:deploy": "npm --prefix server run deploy",
    "server:migrate": "npm --prefix server run db:migrate:remote"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@ionic/angular": "^9.0.11",
    "@ionic/storage-angular": "^4.0.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/cli": "^8.6.2",
    "typescript": "~6.0.3"
  }
}
